# GitHub (private repo supported; a write token is only needed for in-app edits)
GITHUB_OWNER=jeyun123456
GITHUB_REPO=Chocomint-Lab
GITHUB_BRANCH=refactor/chatgpt-sol-router
GITHUB_TOKEN=
# Keep false for public deployments. Set true only on a protected deployment
# when in-app project/shortcut edits should create GitHub Contents commits.
GITHUB_WRITE_ENABLED=false

# Optional path conventions inside the repo
GITHUB_RESULTS_PATH=02_Projects/Master_필요노동과_노동력재생산/코드/결과/주요결과/dashboard

# Server-only absolute path to the Chocomint-Lab checkout. It enables
# local project/shortcut reads and writes when this app is run beside the Vault.
# Prefer this for local editing; do not set it in Vercel.
# Do not set this in Vercel: production reads data through GitHub instead.
LOCAL_REPOSITORY_ROOT=

# Google Calendar (server-only; never prefix these with NEXT_PUBLIC_)
# Preferred: user OAuth refresh-token credentials. The refresh token must have Calendar read/write consent.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional fallback: service account credentials. OAuth is preferred when both are configured.
# Share each target calendar with this service account at "Make changes to events" level.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Comma-separated calendar IDs. For OAuth, "primary" is allowed.
# Whitespace is trimmed and duplicate/empty entries are ignored.
GOOGLE_CALENDAR_IDS=
# Temporary backward-compatible fallback for one existing calendar ID.
GOOGLE_CALENDAR_ID=

# Microsoft 365 / Graph (browser SPA; client ID is public, never add a client secret)
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_AUTHORITY=https://login.microsoftonline.com/organizations

# mtos-agent (memos, milestones, AI inbox, approvals, Codex worker).
# Local dev defaults to http://127.0.0.1:8788. Production must set it explicitly,
# e.g. the P0 tunnel host with an /agent/ path rule; it reuses P0_ACCESS_CLIENT_ID/SECRET.
MTOS_AGENT_URL=

# --- YOLO task management (mtos-agent worker, server only) ---
# Opt-in. Needs P0_SERVICE_TOKEN (>= 32 chars) set identically in the P0 server env.
# The token is accepted by P0 only from loopback, without tunnel headers, and only for /api/tasks.
MTOS_YOLO_ENABLED=0
P0_SERVICE_TOKEN=
MTOS_AI_MODEL=gpt-6-luna
MTOS_YOLO_COLLECT_MINUTES=30
MTOS_YOLO_REEVAL_HOUR_JST=4
# Server checkout of Chocomint-Lab (02_Projects is read from here)
CHOCOMINT_LAB_ROOT=C:/work/chocomint-lab
