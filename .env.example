# GitHub (private repo supported; a write token is only needed for in-app edits)
GITHUB_OWNER=jeyun123456
GITHUB_REPO=Obsidian-Vault
GITHUB_BRANCH=master
GITHUB_TOKEN=
# Keep false for public deployments. Set true only on a protected deployment
# when in-app project/shortcut edits should create GitHub Contents commits.
GITHUB_WRITE_ENABLED=false

# Optional path conventions inside the repo
GITHUB_RESULTS_PATH=projects/thesis/코드/결과/주요결과/dashboard

# Server-only absolute path to the existing Obsidian-Vault checkout. It enables
# local project/shortcut reads and writes when this app is run beside the Vault.
# Prefer this for local editing; do not set it in Vercel.
# Do not set this in Vercel: production reads data through GitHub instead.
LOCAL_REPOSITORY_ROOT=

# Google Calendar (server-only; never prefix these with NEXT_PUBLIC_)
# Preferred: user OAuth refresh-token credentials. The refresh token must have Calendar read/write consent.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional fallback: service account credentials. OAuth is preferred when both are configured.
# Share each target calendar with this service account at "Make changes to events" level.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Comma-separated calendar IDs. For OAuth, "primary" is allowed.
# Whitespace is trimmed and duplicate/empty entries are ignored.
GOOGLE_CALENDAR_IDS=
# Temporary backward-compatible fallback for one existing calendar ID.
GOOGLE_CALENDAR_ID=

# Mail analysis (read by the local Python CLI only; never stored in SQLite)
# Codex CLI + Luna Max example (uses `codex login`; no API key in this file):
# MAIL_AI_PROVIDER=codex-cli
# MAIL_AI_MODEL=gpt-5.6-luna
# MAIL_AI_CODEX_COMMAND=C:/Users/<user>/AppData/Local/Programs/OpenAI/Codex/bin/codex.exe
# LM Studio example:
# MAIL_AI_API_URL=http://127.0.0.1:1234/v1/chat/completions
# MAIL_AI_API_KEY=lm-studio-local
# MAIL_AI_MODEL=qwen/qwen3.5-9b
MAIL_AI_API_URL=
MAIL_AI_API_KEY=
MAIL_AI_MODEL=
# Optional absolute SQLite path. Defaults to local-bridge/data/mail-analysis.db.
MAIL_ANALYSIS_DB_PATH=

# Thunderbird outbound mail (local Bridge only; never prefix with NEXT_PUBLIC_)
# Host/port/security/username/from are normally auto-discovered from Thunderbird.
# Set these overrides only when the profile does not expose the expected SMTP settings.
THUNDERBIRD_SMTP_HOST=
THUNDERBIRD_SMTP_PORT=
# ssl | starttls | plain
THUNDERBIRD_SMTP_SECURITY=
THUNDERBIRD_SMTP_USERNAME=
THUNDERBIRD_SMTP_FROM=
THUNDERBIRD_SMTP_FROM_NAME=
# Secret for password-auth SMTP only. Keep real values in the server PC's local .env.local.
# Thunderbird OAuth2 accounts are detected but are not sent with this password path.
THUNDERBIRD_SMTP_PASSWORD=

# Browser -> local bridge
NEXT_PUBLIC_LOCAL_BRIDGE_URL=http://127.0.0.1:38471

# Microsoft 365 / Graph (browser SPA; client ID is public, never add a client secret)
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_AUTHORITY=https://login.microsoftonline.com/organizations
