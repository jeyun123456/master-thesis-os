# GitHub (private repo supported; a write token is only needed for in-app edits)
GITHUB_OWNER=jeyun123456
GITHUB_REPO=Obsidian-Vault
GITHUB_BRANCH=master
GITHUB_TOKEN=
# Keep false for public deployments. Set true only on a protected deployment
# when in-app project/shortcut edits should create GitHub Contents commits.
GITHUB_WRITE_ENABLED=false

# Optional path conventions inside the repo
GITHUB_RESULTS_PATH=projects/interim-presentation/코드/결과/주요결과/dashboard

# Server-only absolute path to the existing Obsidian-Vault checkout. It enables
# local project/shortcut reads and writes when this app is run beside the Vault.
# Prefer this for local editing; do not set it in Vercel.
# Do not set this in Vercel: production reads data through GitHub instead.
LOCAL_REPOSITORY_ROOT=

# Google Calendar (server-only service account; never prefix these with NEXT_PUBLIC_)
# Share each target calendar with this service account at "See all event details" level.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Comma-separated calendar IDs. Whitespace is trimmed and duplicate/empty entries are ignored.
GOOGLE_CALENDAR_IDS=
# Temporary backward-compatible fallback for one existing calendar ID.
GOOGLE_CALENDAR_ID=

# Browser -> local bridge
NEXT_PUBLIC_LOCAL_BRIDGE_URL=http://127.0.0.1:38471
