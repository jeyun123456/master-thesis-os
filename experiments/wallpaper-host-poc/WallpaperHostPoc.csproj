<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WallpaperHostPoc</RootNamespace>
    <AssemblyName>MasterThesisOSWallpaper</AssemblyName>
    <Version>0.5.0</Version>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>
    <Product>Master Thesis OS Wallpaper Companion</Product>
    <Description>Windows wallpaper companion for Master Thesis OS</Description>
    <ApplicationIcon Condition="Exists('Assets\MasterThesisOSWallpaper.ico')">Assets\MasterThesisOSWallpaper.ico</ApplicationIcon>

    <!-- Lets CI/non-Windows environments restore/build the Windows-targeted project.
         Actual execution still requires Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kept in the repo only as historical Phase 3 reference. It is intentionally
         not part of the executable because forced focus broke native IME composition. -->
    <Compile Remove="NativeImeFocusBridge.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

</Project>
